{
  "name": "cinema-api",
  "version": "1.0.0",
  "description": "API de bilheteria com marcação de assentos - Trabalho Final Programação II + Banco de Dados II (UNOESC)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test:concorrencia": "tsx scripts/teste-concorrencia.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
