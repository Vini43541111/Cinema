# Conexão com o PostgreSQL (RDS em produção)
DATABASE_URL="postgresql://postgres:SENHA@SEU-RDS.us-east-2.rds.amazonaws.com:5432/cinema?sslmode=require"
# Caminho do bundle de CA da AWS (opcional, valida o certificado do RDS)
DB_SSL_CA="/home/ubuntu/rds-global-bundle.pem"

# Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="8h"

PORT=3333
NODE_ENV=production
# Prazo da reserva temporária, em minutos
RESERVA_MINUTOS=10
# Origem permitida no CORS (URL do front). Use * só em desenvolvimento.
CORS_ORIGIN="https://seu-dominio"
# Pasta onde ficam as capas enviadas
UPLOAD_DIR="uploads"

# Usuário operador criado pelo seed
SEED_ADMIN_EMAIL="admin@cinema.com"
SEED_ADMIN_SENHA="Admin@123"
